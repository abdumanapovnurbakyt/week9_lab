{
  "uid": "lab6-telemetry",
  "title": "Lab 6 - телеметрия (TimescaleDB)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "lab6",
    "timescaledb"
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Устройство",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT device_id FROM devices ORDER BY 1",
        "refresh": 1,
        "sort": 3,
        "current": {
          "text": "42",
          "value": "42"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Последняя температура, устройство ${device}",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, value AS \"температура\" FROM telemetry_narrow WHERE device_id = $device AND metric_id = 1 ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Температура: среднее по часам (агрегат 1 ч)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, avg(sum_v / cnt) FILTER (WHERE device_id = $device) AS \"устройство ${device}\", sum(sum_v) / sum(cnt) AS \"весь парк\" FROM cagg_narrow_1h WHERE metric_id = 1 AND $__timeFilter(bucket) GROUP BY bucket ORDER BY bucket",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Аномалии температуры по суткам (устройств с выбросом, агрегат 1 сут)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "time",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, count(*) FILTER (WHERE max_v > 45 OR min_v < -10) AS \"устройств с выбросом\" FROM cagg_narrow_1d WHERE metric_id = 1 AND $__timeFilter(bucket) GROUP BY bucket ORDER BY bucket",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Заряд батареи по парку, мВ (агрегат 1 сут)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, min(min_v) AS \"минимум\", sum(sum_v) / sum(cnt) AS \"среднее\" FROM cagg_narrow_1d WHERE metric_id = 3 AND $__timeFilter(bucket) GROUP BY bucket ORDER BY bucket",
          "refId": "A"
        }
      ]
    }
  ]
}